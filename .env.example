# Секреты задаются в переменных Bothost, этот файл бот не загружает.
BOT_TOKEN=токен_из_BotFather
OWNER_ID=379721932
# Имя и обращения без @; username Telegram бот определит сам.
BOT_NAME=Кореш
BOT_ALIASES=кореш,корешок
# Необязательно: если пусто, группу подключает владелец командой /allow.
ALLOWED_CHAT_IDS=
# Модель по умолчанию берётся из Codex. Указать другую можно здесь.
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
DATA_DIR=/app/data
CODEX_HOME=/app/data/codex
SPONTANEOUS_CHANCE=0.04
SPONTANEOUS_COOLDOWN=600
MAX_TURNS_PER_HOUR=30
CONTEXT_MESSAGES=40
HISTORY_DAYS=7
CODEX_TIMEOUT=150
MAX_QUEUE=12
PORT=8080
# Ежедневный розыгрыш, московское время; в группе можно менять /pidortime.
DAILY_DRAW_TIME=12:00
